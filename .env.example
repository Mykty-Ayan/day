# Database
DATABASE_URL=postgresql+asyncpg://day:changeme@postgres:5432/day
POSTGRES_PASSWORD=changeme

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=changeme
S3_BUCKET_NAME=day-uploads

# Auth / JWT
SECRET_KEY=change-this-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App
APP_ENV=development
BACKEND_URL=http://backend:8000
FRONTEND_URL=http://localhost:3000

# AI / LLM provider (ai-service)
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_APP_NAME=day-ai-service
OPENROUTER_HTTP_REFERER=http://localhost:3000
ANTHROPIC_API_KEY=

# AI parser (optional Airbnb MCP enrichment stage)
AIRBNB_MCP_ENABLED=false
AIRBNB_MCP_COMMAND=npx
AIRBNB_MCP_ARGS=-y @openbnb/mcp-server-airbnb
AIRBNB_MCP_IGNORE_ROBOTS_TEXT=true
AIRBNB_MCP_TIMEOUT_SECONDS=20
AIRBNB_MCP_WORKDIR=
