DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/day
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=day-uploads

JWT_SECRET=your-secret-key-min-16-chars-required
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=["http://localhost:5173"]

# Channex channel manager (staging by default; prod: https://secure.channex.io)
CHANNEX_API_URL=https://staging.channex.io
CHANNEX_API_KEY=
CHANNEX_WEBHOOK_SECRET=

# Public origins. PUBLIC_BASE_URL is this API, PUBLIC_APP_URL is the front end —
# the Mini App lives at PUBLIC_APP_URL/tma and the bot's menu button is pointed
# there on every boot, so it must be the address Telegram can actually open.
PUBLIC_BASE_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:5173

# Telegram host-facing bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MENU_BUTTON_TEXT=Day

# Assistant over OpenRouter. Without a key /assistant/ask answers 503 and the
# bot understands commands only.
ASSISTANT_API_KEY=
ASSISTANT_API_URL=https://openrouter.ai/api/v1
ASSISTANT_MODEL=google/gemini-3.7-flash
# Empty: voice notes go through ASSISTANT_MODEL. Set it to a cheaper
# audio-capable model (e.g. google/gemini-2.5-flash-lite) to stop paying
# reasoning prices for speech.
ASSISTANT_TRANSCRIBE_MODEL=
