# Production variables for docker-compose.prod.yml (paste into Dokploy's env editor).
# Generate every secret on the server, never reuse a development value.
#   openssl rand -base64 36

# ---------- database ----------
POSTGRES_DB=day
POSTGRES_USER=day
POSTGRES_PASSWORD=

# ---------- auth ----------
# Rotating this logs everyone out. Minimum 16 characters, use 32+.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------- domains ----------
# The browser origins allowed to call the API — the app domain, nothing else.
# JSON array, quoted.
CORS_ORIGINS=["https://app.example.com"]
# Public HTTPS address of the API itself; both bots register webhooks here.
PUBLIC_BASE_URL=https://api.example.com
# Baked into the frontend bundle at build time — rebuild after changing it.
VITE_API_URL=https://api.example.com/api/v1

# ---------- object storage (MinIO) ----------
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=day-uploads
S3_PUBLIC_READ=true
# Address photos are served from to the browser. Point a domain at the MinIO
# service in Dokploy; leaving it empty makes uploaded photos unreachable.
S3_PUBLIC_ENDPOINT=https://files.example.com

# ---------- Telegram bot (host-facing) ----------
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Any random string; Telegram echoes it back on every webhook call and requests
# without it are rejected.
TELEGRAM_WEBHOOK_SECRET=

# ---------- WhatsApp bot via whapi.cloud (guest-facing) ----------
WHAPI_TOKEN=
WHAPI_API_URL=https://gate.whapi.cloud
# Random string appended to the webhook URL and checked on delivery.
WHAPI_WEBHOOK_SECRET=

# ---------- backups ----------
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
